local function Slider(page, name, minV, maxV, default, cb)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 50)
    f.BackgroundColor3 = Color3.fromRGB(30, 22, 26)
    f.BorderSizePixel = 0
    f.Parent = page
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
    local stk = Instance.new("UIStroke", f); stk.Color = Color3.fromRGB(100, 50, 30); stk.Thickness = 1

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 22)
    lbl.Position = UDim2.new(0, 10, 0, 2)
    lbl.BackgroundTransparency = 1
    lbl.Text = name .. ": " .. string.format("%.1f", default)
    lbl.TextColor3 = Color3.fromRGB(230, 220, 210)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = f

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 6)
    bar.Position = UDim2.new(0, 10, 1, -14)
    bar.BackgroundColor3 = Color3.fromRGB(50, 35, 40)
    bar.BorderSizePixel = 0
    bar.Parent = f
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - minV) / (maxV - minV), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(255, 120, 50)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local fg = Instance.new("UIGradient", fill)
    fg.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 220, 60)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 30, 30)),
    }

    local drag = false
    local function upd(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local val = minV + rel * (maxV - minV)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = name .. ": " .. string.format("%.1f", val)
        if cb then pcall(cb, val) end
    end

    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = true; upd(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
end

local function Dropdown(page, name, options, default, cb)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 34)
    f.BackgroundColor3 = Color3.fromRGB(30, 22, 26)
    f.BorderSizePixel = 0
    f.ClipsDescendants = true
    f.Parent = page
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
    local stk = Instance.new("UIStroke", f); stk.Color = Color3.fromRGB(100, 50, 30); stk.Thickness = 1

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 34)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = name .. ": " .. default
    lbl.TextColor3 = Color3.fromRGB(230, 220, 210)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = f

    local btn = Instance.new("TextButton"); btn.Size = UDim2.fromScale(1, 1); btn.BackgroundTransparency = 1; btn.Text = ""; btn.Parent = f
    local opened = false; local optFrames = {}

    local function closeAll()
        for _, o in ipairs(optFrames) do o.Visible = false end
        f.Size = UDim2.new(1, 0, 0, 34); opened = false
    end

    btn.MouseButton1Click:Connect(function()
        opened = not opened
        if opened then
            local i = 0
            for _, opt in ipairs(options) do
                if not optFrames[opt] then
                    local ob = Instance.new("TextButton")
                    ob.Size = UDim2.new(1, 0, 0, 28)
                    ob.Position = UDim2.new(0, 0, 0, 34 + i * 28)
                    ob.BackgroundColor3 = Color3.fromRGB(22, 16, 20)
                    ob.BorderSizePixel = 0
                    ob.Text = opt
                    ob.TextColor3 = Color3.fromRGB(200, 180, 170)
                    ob.TextSize = 11
                    ob.Font = Enum.Font.Gotham
                    ob.Parent = f
                    optFrames[opt] = ob
                    ob.MouseButton1Click:Connect(function()
                        lbl.Text = name .. ": " .. opt
                        if cb then pcall(cb, opt) end
                        closeAll()
                    end)
                end
                optFrames[opt].Visible = true
                i = i + 1
            end
            f.Size = UDim2.new(1, 0, 0, 34 + #options * 28)
        else closeAll() end
    end)
end

