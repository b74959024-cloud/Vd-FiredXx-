local function GetSkillCheck()
    for _, gName in ipairs({ "SkillCheckPromptGui", "SkillCheckPromptGui-con" }) do
        local gui = PlayerGui:FindFirstChild(gName, true)
        if gui then
            local check = gui:FindFirstChild("Check", true)
            if check and check.Visible then
                local line = check:FindFirstChild("Line", true)
                local goal = check:FindFirstChild("Goal", true)
                if line and goal then return line, goal end
            end
        end
    end
end

local function AngularDelta(f, t)
    local d = t - f
    if d > 180 then d = d - 360 end
    if d < -180 then d = d + 360 end
    return d
end

local function CrossedZone(prev, curr, s, e)
    local function inZone(r) if s > e then return r >= s or r <= e end; return r >= s and r <= e end
    if inZone(curr) then return true end
    if prev == nil then return false end
    local delta = AngularDelta(prev, curr)
    local steps = math.abs(math.floor(delta))
    if steps < 2 then return false end
    local stepSize = delta / steps
    for i = 1, steps do if inZone((prev + stepSize * i) % 360) then return true end end
    return false
end

local function NormalSkill()
    local line, goal = GetSkillCheck()
    if not (line and goal) then SkillState.LastGoalRot = nil; SkillState.Clicked = false; SkillState.LastLineRot = nil; SkillState.LastTick = nil; SkillState.WasActive = false; return end
    local lr, gr = line.Rotation % 360, goal.Rotation % 360
    local now = os.clock()
    if not SkillState.WasActive then SkillState.WasActive = true; SkillState.Clicked = false; SkillState.LastGoalRot = gr; SkillState.LastLineRot = lr; SkillState.LastTick = now; return end
    if SkillState.LastGoalRot and math.abs(AngularDelta(SkillState.LastGoalRot, gr)) > 5 then SkillState.Clicked = false; SkillState.LastLineRot = nil; SkillState.LastTick = nil end
    SkillState.LastGoalRot = gr
    if SkillState.Clicked then SkillState.LastLineRot = lr; SkillState.LastTick = now; return end
    if SkillState.LastLineRot and SkillState.LastTick then
        local dt = now - SkillState.LastTick
        if dt > 0 then
            local speed = AngularDelta(SkillState.LastLineRot, lr) / dt
            local pred = (lr + speed * dt * 0) % 360
            if CrossedZone(SkillState.LastLineRot, pred, (gr + 104) % 360, (gr + 109) % 360) then
                SkillState.Clicked = true
                task.spawn(function() task.wait(0.03); PressSkill() end)
            end
        end
    end
    SkillState.LastLineRot = lr; SkillState.LastTick = now
end

local function PerfectSkill()
    local line, goal = GetSkillCheck()
    if not (line and goal) then SkillState.LastGoalRot = nil; SkillState.Clicked = false; SkillState.LastLineRot = nil; SkillState.LastTick = nil; SkillState.WasActive = false; return end
    local lr, gr = line.Rotation % 360, goal.Rotation % 360
    local now = os.clock()
    if not SkillState.WasActive then SkillState.WasActive = true; SkillState.Clicked = false; SkillState.LastGoalRot = gr; SkillState.LastLineRot = lr; SkillState.LastTick = now; return end
    if SkillState.LastGoalRot and math.abs(AngularDelta(SkillState.LastGoalRot, gr)) > 5 then SkillState.Clicked = false; SkillState.LastLineRot = nil; SkillState.LastTick = nil end
    SkillState.LastGoalRot = gr
    if SkillState.Clicked then SkillState.LastLineRot = lr; SkillState.LastTick = now; return end
    if SkillState.LastLineRot and SkillState.LastTick then
        local dt = now - SkillState.LastTick
        if dt > 0 then
            local speed = AngularDelta(SkillState.LastLineRot, lr) / dt
            local pred = (lr + speed * dt * 0) % 360
            if CrossedZone(SkillState.LastLineRot, pred, (gr + 104) % 360, (gr + 108) % 360) then
                SkillState.Clicked = true; PressSkill()
            end
        end
    end
    SkillState.LastLineRot = lr; SkillState.LastTick = now
end

local function InstantSkill()
    if SkillState.InstantClicked then return end
    local prompt = PlayerGui:FindFirstChild("SkillCheckPromptGui") or PlayerGui:FindFirstChild("SkillCheckPromptGui-con")
    if not prompt then return end
    local check = prompt:FindFirstChild("Check")
    if not check or not check.Visible then return end
    local line = check:FindFirstChild("Line")
    local goal = check:FindFirstChild("Goal")
    if not line or not goal then return end
    line.Rotation = goal.Rotation + 109
    SkillState.InstantClicked = true
    task.spawn(function() PressSkill(); task.wait(0.2); SkillState.InstantClicked = false end)
end

