local function HealRemote()
    return ReplicatedStorage:FindFirstChild("Remotes")
        and ReplicatedStorage.Remotes:FindFirstChild("Healing")
        and ReplicatedStorage.Remotes.Healing:FindFirstChild("HealEvent")
end

local function DoSelfHeal(v)
    local char = GetChar(); if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local r = HealRemote(); if r then pcall(function() r:FireServer(hrp, v) end) end
end

local function DoOtherHeal(p, v)
    if not p or not p.Character then return end
    local hrp = p.Character:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local r = HealRemote(); if r then pcall(function() r:FireServer(hrp, v) end) end
end

local function SetInstantHealSelf(v)
    CFG.InstantHealSelf = v
    if v then
        if InstantHealConn then InstantHealConn:Disconnect() end
        local healActive = false
        InstantHealConn = RunService.Heartbeat:Connect(function()
            if not CFG.InstantHealSelf then return end
            local char = GetChar(); local hum = GetHum(); if not hum then return end
            if hum.Health >= hum.MaxHealth * 0.9 then if healActive then healActive = false; DoSelfHeal(false) end; return end
                        if healActive then local check = char:FindFirstChild("CheckInterractable"); if check and not check:GetAttribute("isHealing") then healActive = false end end
            if not healActive then healActive = true; DoSelfHeal(true) end
        end)
    else
        if InstantHealConn then InstantHealConn:Disconnect(); InstantHealConn = nil end
        pcall(function() DoSelfHeal(false) end)
    end
end

local function SetHealAll(v)
    CFG.InstantHealAll = v
    if v then
        if AutoHealAllConn then AutoHealAllConn:Disconnect() end
        local active = {}
        AutoHealAllConn = RunService.Heartbeat:Connect(function()
            if not CFG.InstantHealAll then return end
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 and hum.Health < hum.MaxHealth * 0.9 then
                        if not active[p] then active[p] = true; DoOtherHeal(p, true) end
                    else
                        if active[p] then active[p] = nil; DoOtherHeal(p, false) end
                    end
                end
            end
        end)
    else
        if AutoHealAllConn then AutoHealAllConn:Disconnect(); AutoHealAllConn = nil end
    end
end

