local function GetRole()
    local t = LocalPlayer.Team
    if not t then return "Lobby" end
    if t.Name == "Killer" then return "Killer" end
    if t.Name == "Survivors" then return "Survivor" end
    return "Lobby"
end

local function IsKillerPlayer(p) return p and p.Team and p.Team.Name == "Killer" end
local function IsSurvivorPlayer(p) return p and p.Team and p.Team.Name == "Survivors" end
local function IsDowned(char)
    if not char then return true end
    local st = char:GetAttribute("State")
    return st == "Downed" or st == "Dead"
end
local function GetChar() return LocalPlayer.Character end
local function GetHum() local c = GetChar(); return c and c:FindFirstChildOfClass("Humanoid") end
local function GetRoot() local c = GetChar(); return c and c:FindFirstChild("HumanoidRootPart") end

