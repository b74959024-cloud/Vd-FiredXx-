local GenBypass = { Processed = {} }

local function GetGens()
    local list = {}
    local map = Workspace:FindFirstChild("Map"); if not map then return list end
    for _, v in ipairs(map:GetDescendants()) do
        if v:IsA("Model") and v.Name == "Generator" and (v:GetAttribute("RepairProgress") ~= nil or v:GetAttribute("kickcount") ~= nil) then
            table.insert(list, v)
        end
    end
    return list
end

local function GetGenPts(gen)
    local pts = {}
    for _, o in ipairs(gen:GetChildren()) do if o.Name:find("GeneratorPoint") and o:IsA("BasePart") then table.insert(pts, o) end end
    return pts
end

local function WaitRepair(pt, t)
    local s = tick()
    while tick() - s < (t or 1) do if pt:GetAttribute("IsRepairing") == true then return true end; task.wait(0.05) end
    return false
end

local function DoRepair(targetPt)
    local gen = targetPt.Parent
    if GenBypass.Processed[gen] then return end
    GenBypass.Processed[gen] = true
    local char = GetChar(); local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then GenBypass.Processed[gen] = nil; return end
    local RepairEv = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Generator") and ReplicatedStorage.Remotes.Generator:FindFirstChild("RepairEvent")
    local origCF = hrp.CFrame
    pcall(function()
        for _, pt in ipairs(GetGenPts(gen)) do
            if pt ~= targetPt and pt.Parent then
                hrp.Anchored = true; hrp.CFrame = pt.CFrame; task.wait(0.15)
                pcall(function() if RepairEv then RepairEv:FireServer(pt, true) end end)
                if not WaitRepair(pt, 0.8) then
                    pcall(function() if RepairEv then RepairEv:FireServer(pt, false) end end)
                    task.wait(0.1); hrp.CFrame = pt.CFrame; task.wait(0.15)
                    pcall(function() if RepairEv then RepairEv:FireServer(pt, true) end end)
                    WaitRepair(pt, 0.5)
                end
                hrp.Anchored = false; task.wait(0.05)
            end
        end
    end)
    pcall(function() if hrp and hrp.Parent then hrp.Anchored = false; hrp.CFrame = origCF end end)
    task.wait(0.1)
    pcall(function() if RepairEv then RepairEv:FireServer(targetPt, false) end end)
end

local function GetNearestGenPt()
    local hrp = GetRoot(); if not hrp then return nil, math.huge end
    local best, bestD = nil, math.huge
    for _, g in ipairs(GetGens()) do for _, pt in ipairs(GetGenPts(g)) do
        local d = (hrp.Position - pt.Position).Magnitude
        if d < bestD then bestD = d; best = pt end
    end end
    return best, bestD
end

