local function PlayerKey(p) return tostring(p.UserId) end

local function EnsureHighlight(name, adornee, color, isPlayer)
    if not adornee or not adornee.Parent then return end
    local folder = GetESPFolder()
    local hl = folder:FindFirstChild(name)
    if not hl then hl = Instance.new("Highlight"); hl.Name = name; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent = folder end
    hl.Adornee = adornee; hl.FillColor = color; hl.OutlineColor = color
    hl.FillTransparency = isPlayer and 0.75 or 0.9; hl.OutlineTransparency = 0.2; hl.Enabled = true
end

local function UpdateTag(p, char, head, color)
    if not CFG.ESP_Nametag and not CFG.ESP_Distance then
        local f = GetESPFolder(); local t = f:FindFirstChild("Tag_" .. PlayerKey(p)); if t then t:Destroy() end; return
    end
    if not head or not head.Parent then return end
    local f = GetESPFolder(); local name = "Tag_" .. PlayerKey(p); local tag = f:FindFirstChild(name)
    if not tag then
        tag = Instance.new("BillboardGui"); tag.Name = name; tag.AlwaysOnTop = true; tag.LightInfluence = 0
        tag.Size = UDim2.new(0, 200, 0, 30); tag.StudsOffset = Vector3.new(0, 2.6, 0); tag.Parent = f
        local lbl = Instance.new("TextLabel"); lbl.Name = "Label"; lbl.BackgroundTransparency = 1
        lbl.Size = UDim2.fromScale(1, 1); lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 13
        lbl.TextStrokeTransparency = 0.5; lbl.TextStrokeColor3 = Color3.new(0, 0, 0); lbl.Parent = tag
    end
    tag.Adornee = head; tag.Enabled = true
    local lines = {}
    if CFG.ESP_Nametag then table.insert(lines, p.Name) end
    if CFG.ESP_Distance then
        local myRoot = GetRoot(); local tRoot = char and char:FindFirstChild("HumanoidRootPart")
        if myRoot and tRoot then table.insert(lines, "[" .. math.floor((myRoot.Position - tRoot.Position).Magnitude) .. "m]") end
    end
    local lbl = tag:FindFirstChild("Label")
    if lbl then lbl.Text = table.concat(lines, " "); lbl.TextColor3 = color end
end

local function ApplyPlayerESP(p)
    if p == LocalPlayer then return end
    local char = p.Character; local f = GetESPFolder()
    if not CFG.ESP_PlayerMaster or not char then
        local h = f:FindFirstChild("P_" .. PlayerKey(p)); if h then h:Destroy() end
        local t = f:FindFirstChild("Tag_" .. PlayerKey(p)); if t then t:Destroy() end; return
    end
    local isK = IsKillerPlayer(p); local isS = IsSurvivorPlayer(p)
    local enabled = (isK and CFG.ESP_Killer) or (isS and CFG.ESP_Survivor)
    if not enabled then
        local h = f:FindFirstChild("P_" .. PlayerKey(p)); if h then h:Destroy() end
        local t = f:FindFirstChild("Tag_" .. PlayerKey(p)); if t then t:Destroy() end; return
    end
    local color = isK and ESP_COLORS.Killer or ESP_COLORS.Survivor
    EnsureHighlight("P_" .. PlayerKey(p), char, color, true)
    UpdateTag(p, char, char:FindFirstChild("Head"), color)
end

