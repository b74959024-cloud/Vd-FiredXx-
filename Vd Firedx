local MW = { Enabled = false, Yaw = nil, Sway = 0, LastEnabled = false }

RunService.Heartbeat:Connect(function(dt)
    MW.Enabled = CFG.Moonwalk
    local char = GetChar(); local hum = GetHum(); local root = GetRoot()
    if not char or not hum or not root then return end
    if MW.Enabled ~= MW.LastEnabled then
        hum.AutoRotate = not MW.Enabled
        MW.LastEnabled = MW.Enabled
        if MW.Enabled then local _, y = root.CFrame:ToEulerAnglesYXZ(); MW.Yaw = math.deg(y) end
    end
    if not MW.Enabled or hum.Health <= 0 then return end
    hum.AutoRotate = false
    local cam = workspace.CurrentCamera; if not cam then return end
    local look = cam.CFrame.LookVector
    local targetYaw = math.deg(math.atan2(look.X, look.Z)) + 180
    local currentYaw = MW.Yaw or targetYaw
    local diff = (targetYaw - currentYaw + 180) % 360 - 180
    currentYaw = currentYaw + diff * (0.22 * math.clamp((dt or 1/60) * 60, 0, 3))
    MW.Yaw = currentYaw
    local moving = hum.MoveDirection.Magnitude > 0.01
    local targetSway = moving and math.sin(tick() * CFG.MoonwalkZigzag) * 48 or 0
    MW.Sway = (MW.Sway or 0) + (targetSway - (MW.Sway or 0)) * 0.38
    root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(currentYaw + MW.Sway), 0)
    if moving then hum:Move(hum.MoveDirection * CFG.MoonwalkBoost, false) end
end)

