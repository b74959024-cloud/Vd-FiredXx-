local _vaultedWindows = {}
local _lastVaultScan = 0
local KYS_Cache = { Windows = {}, Pallets = {}, Generators = {}, Hooks = {}, Gates = {} }

local function ScanMap()
    KYS_Cache.Windows = {}; KYS_Cache.Pallets = {}; KYS_Cache.Generators = {}; KYS_Cache.Hooks = {}; KYS_Cache.Gates = {}
    local map = Workspace:FindFirstChild("Map"); if not map then return end
    for _, obj in ipairs(map:GetDescendants()) do
        if obj:IsA("Model") then
            local part = obj:FindFirstChild("HitBox", true) or obj:FindFirstChild("GeneratorPoint", true) or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
            if part then
                local n = obj.Name
                if n == "Generator" then table.insert(KYS_Cache.Generators, {model=obj, part=part})
                elseif n == "Gate" then table.insert(KYS_Cache.Gates, {model=obj, part=part})
                elseif n == "Hook" then table.insert(KYS_Cache.Hooks, {model=obj, part=part})
                elseif n == "Palletwrong" or n:lower():find("pallet") then table.insert(KYS_Cache.Pallets, {model=obj, part=part})
                elseif n == "Window" then table.insert(KYS_Cache.Windows, {model=obj, part=part}) end
            end
        elseif obj:IsA("BasePart") then
            if obj.Name == "VaultTrigger" then table.insert(KYS_Cache.Windows, {model=obj.Parent, part=obj}) end
            if obj.Name == "PalletPoint" or obj.Name == "PalletPointSlide" then table.insert(KYS_Cache.Pallets, {model=obj.Parent, part=obj}) end
        end
    end
end
ScanMap()
Workspace.ChildAdded:Connect(function(c) if c.Name == "Map" then task.delay(0.5, ScanMap) end end)

RunService.Heartbeat:Connect(function()
    if not CFG.SwiftVault then return end
    if GetRole() ~= "Survivor" then return end
    if tick() - _lastVaultScan < 0.15 then return end
    _lastVaultScan = tick()
    pcall(function()
        local char = GetChar(); local myRoot = GetRoot(); local hum = GetHum()
        if not myRoot or not hum or hum.Health <= 0 then return end
        if myRoot.AssemblyLinearVelocity.Magnitude < 1 then return end
        local winFolder = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Window")
        if not winFolder then return end
        local groups = {}
        for _, win in ipairs(KYS_Cache.Windows or {}) do
            local part = win.part; if not part then continue end
            local rootWin = part
            if part.Name == "VaultPoint" and part.Parent then rootWin = part.Parent.Parent
            elseif part.Name == "VaultTrigger" and part.Parent then rootWin = part.Parent end
            if rootWin then groups[rootWin] = groups[rootWin] or {}
                local dup = false; for _, p2 in ipairs(groups[rootWin]) do if p2 == part then dup = true break end end
                if not dup then table.insert(groups[rootWin], part) end
            end
        end
        for rootWin, parts in pairs(groups) do
            local allVTs = {}
            for _, child in ipairs(rootWin:GetChildren()) do if child.Name == "VaultTrigger" then table.insert(allVTs, child) end end
            if #allVTs == 0 then continue end
            local nearestVT, nearestDist = nil, math.huge
            for _, vt in ipairs(allVTs) do
                local pos = vt:IsA("BasePart") and vt.Position or (vt.PrimaryPart and vt.PrimaryPart.Position)
                if pos then local d = (myRoot.Position - pos).Magnitude; if d < nearestDist then nearestDist = d; nearestVT = vt end end
            end
            if not nearestVT or nearestDist > 6 then continue end
            if tick() - (_vaultedWindows[rootWin] or 0) < 3 then continue end
            local vaultEv = winFolder:FindFirstChild("VaultEvent")
            local fastVault = winFolder:FindFirstChild("fastvault")
